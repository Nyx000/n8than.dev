# build output
dist/
# server-only atomic-release artifacts (created by deploy.yml on the box)
/releases/
/current
# generated types
.astro/
# brainstorming visual companion
.superpowers/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# local git worktrees (subagent-driven-development isolation)
.worktrees/

/docs/

# private career area - never publish
/career/

# local Claude Code settings (enabled plugins, permissions) - machine-specific,
# not project config. Ignored for a second reason too: this directory was
# untracked but NOT ignored, which left it one `git add -A` from a public push,
# and it is the tempting wrong place to put anything from /career/ if that
# area's skill fails to load. Nothing from career/ ever belongs here.
.claude/
