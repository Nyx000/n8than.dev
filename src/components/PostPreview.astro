---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  tags?: string[];
}

const { title, description, pubDate, slug, tags } = Astro.props;
---

<article class="k-panel">
  <h2 class="k-panel__title"><a href={'/blog/' + slug}>{title}</a></h2>
  <time datetime={pubDate.toISOString()}>
    {
      pubDate.toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      })
    }
  </time>
  <p class="k-panel__body">{description}</p>
  {
    tags && tags.length > 0 && (
      <ul class="k-tags">
        {tags.map((tag) => (
          <li>{tag}</li>
        ))}
      </ul>
    )
  }
</article>

<style>
  /* The title is the one link in a preview, so it carries the underline. */
  .k-panel__title a {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 0.2em;
  }

  .k-panel__title a:hover {
    color: var(--color-accent);
  }

  time {
    display: block;
    margin-top: var(--space-xs);
    font-family: var(--font-display);
    font-size: 0.95rem;
    color: var(--color-muted);
  }
</style>
