---
import { statusLabel, type Project } from '../data/projects';

type Props = Project;

const project = Astro.props;
const { title, description, url, tags, status, stats, details } = project;
const isExternal = !!url && !url.startsWith('/');
// A repo link is not a running thing: only a live project gets the filled button.
const isLive = status === 'live';
---

<article
  class:list={['k-panel', { 'k-panel--live': isLive, 'k-panel--retired': status === 'retired' }]}
>
  <div class="k-panel__head">
    <h3 class="k-panel__title">{title}</h3>
    <span class={`k-status k-status--${status}`}>{statusLabel(project)}</span>
  </div>
  <p class="k-panel__body">{description}</p>
  <div class="k-panel__foot">
    <ul class="k-tags">
      {tags.map((tag) => <li>{tag}</li>)}
    </ul>
    <div class="actions">
      {
        url && (
          <a
            class:list={['k-btn', { 'k-btn--primary': isLive }]}
            href={url}
            target={isExternal ? '_blank' : undefined}
            rel={isExternal ? 'noopener noreferrer' : undefined}
          >
            {isLive ? 'Visit site' : 'View source'}
            <span class="sr-only">
              : {title}
              {isExternal && ' (opens in new tab)'}
            </span>
          </a>
        )
      }
      {
        details && (
          <button class="k-btn details-btn" type="button" aria-expanded="false">
            Details
            <span class="sr-only">: {title}</span>
            <span class="chev" aria-hidden="true">
              &#9656;
            </span>
          </button>
        )
      }
    </div>
  </div>
  {
    details && (
      <div class="expand" inert>
        <div class="expand-inner">
          <div class="expand-content">
            <Fragment set:html={details} />
            {stats && (
              <dl class="k-readouts">
                {stats.map((s) => (
                  <div class="k-readout">
                    <dt>{s.label}</dt>
                    <dd>{s.value}</dd>
                  </div>
                ))}
              </dl>
            )}
          </div>
        </div>
      </div>
    )
  }
</article>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll('.details-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const panel = btn.closest('.k-panel')?.querySelector('.expand');
        if (!panel) return;
        const open = btn.getAttribute('aria-expanded') !== 'true';
        btn.setAttribute('aria-expanded', String(open));
        // inert keeps the collapsed panel's links out of the tab order + AT tree.
        panel.toggleAttribute('inert', !open);
      });
    });
  });
</script>

<style>
  /* The record itself is the kit's panel. Only the expand behaviour and the
     detail text live here. */
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .details-btn {
    gap: 0.5em;
  }

  /* Chevron rotates on expand instead of swapping the button's text, which
     teleported the glyph and nudged the button width. */
  .chev {
    transition: transform var(--dur-fast) var(--ease);
  }

  .details-btn[aria-expanded='true'] .chev {
    transform: rotate(90deg);
  }

  .expand {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--dur-slow) var(--ease);
  }

  .expand:not([inert]) {
    grid-template-rows: 1fr;
  }

  .expand-inner {
    overflow: hidden;
  }

  .expand-content {
    padding-top: var(--space-md);
    margin-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }

  .expand-content :global(.hook) {
    max-width: var(--measure);
    margin: 0 0 var(--space-md);
  }

  /* In-text links need more than colour to stand apart from the prose. */
  .expand-content :global(.hook a) {
    text-decoration: underline;
  }

  .expand-content :global(.highlights) {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .expand-content :global(.highlights li) {
    max-width: var(--measure);
    padding-left: 1em;
    position: relative;
  }

  .expand-content :global(.highlights li::before) {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 4px;
    height: 4px;
    background: var(--color-accent);
    border-radius: 50%;
  }

  .expand-content :global(.highlights strong) {
    font-weight: 600;
  }

  .expand-content .k-readouts {
    margin-top: var(--space-md);
  }

  @media (prefers-reduced-motion: reduce) {
    .expand,
    .chev {
      transition: none;
    }
  }
</style>
