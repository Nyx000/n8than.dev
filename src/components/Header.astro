---
import NowPlaying from './NowPlaying.astro';
import Jukebox from './Jukebox.astro';

const pathname = Astro.url.pathname;

const links = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Projects' },
  { href: '/recognition', label: 'Recognition' },
  { href: '/about', label: 'About' },
];

function isActive(href: string): boolean {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
---

<header class="site-header" transition:animate="none">
  <a href="/" class="brand">n8than.dev</a>
  <nav>
    {
      links.map((link) => (
        <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
          {link.label}
        </a>
      ))
    }
    <a
      href="/game"
      class="nav-live"
      id="nav-live"
      aria-current={isActive('/game') ? 'page' : undefined}
      hidden>Live</a
    >
  </nav>
  <div class="hdr-music">
    <NowPlaying>
      <Jukebox />
    </NowPlaying>
  </div>
</header>

<script>
  // The "Live" nav link appears only while the stream is up. Same status route the /live page
  // polls (MediaMTX's path API behind Caddy); a failed check just leaves the link hidden.
  const LIVE_POLL_MS = 30_000;
  let liveTimer: number | undefined;

  async function checkLive() {
    const link = document.getElementById('nav-live');
    if (!link) return;
    try {
      const res = await fetch('/api/live/status', { cache: 'no-store' });
      const online = res.ok && ((await res.json()) as { online?: boolean }).online === true;
      link.hidden = !online;
    } catch {
      link.hidden = true;
    }
  }

  document.addEventListener('astro:page-load', () => {
    if (liveTimer != null) clearInterval(liveTimer);
    void checkLive();
    liveTimer = window.setInterval(checkLive, LIVE_POLL_MS);
  });
</script>

<style>
  .site-header {
    position: relative; /* dropdown anchor for the header music widget */
    /* Astro's transition:animate="none" still assigns a view-transition-name, which makes
       the header a stacking context — the .np-panel's own z-index can't escape it. Lift the
       whole header above the hero canvas (z auto) but below #grain (z 10) / scanlines (z 9)
       so the film-grain overlay still covers the dropdown. */
    z-index: 5;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    column-gap: var(
      --space-lg
    ); /* guarantees space between brand and nav; kills the ~600-700px zero-gap crowding */
    align-items: center;
    padding: var(--space-md) var(--space-lg);
    width: 100%;
    max-width: var(--container);
    margin: 0 auto;
    border-bottom: 1px solid var(--color-border);
  }

  /* Third grid cell (the trailing 1fr): the now-playing line + its dropdown.
     Deliberately NOT position: relative — the .np-panel dropdown anchors to
     .site-header instead, so top: 100% lands flush under the header's bottom
     border (this cell is vertically centered and its bottom sits above the
     border by the header padding). min-width: 0 lets the line ellipsize
     instead of forcing the grid wider. */
  .hdr-music {
    /* stretch (default), NOT justify-self: end — end sizes the item to fit-content, which
       let a long track title overflow the 1fr track leftward over the nav. Stretched, the
       cell equals the track and the line packs right inside it (justify-content on .np-line),
       so the text can only ellipsize, never spill. */
    min-width: 0;
  }

  .brand {
    font-family: var(--font-display);
    font-weight: 400; /* Share Tech Mono is single-weight; 700 was synthetic bold */
    font-size: 1.25rem;
    color: var(--color-text);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .brand:hover {
    color: var(--color-accent);
  }

  nav {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  nav a {
    color: var(--color-muted);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.92rem;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  nav a:hover {
    color: var(--color-text);
  }

  nav a[aria-current='page'] {
    color: var(--color-accent);
    font-weight: 600;
  }

  /* Shown only while the stream is up (script below). */
  .nav-live {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }

  .nav-live[hidden] {
    display: none;
  }

  nav a.nav-live {
    color: var(--color-accent);
  }

  .nav-live::before {
    content: '';
    width: 0.5em;
    height: 0.5em;
    border-radius: 50%;
    background: var(--color-accent);
    animation: nav-live-pulse 1.6s var(--ease) infinite;
  }

  @keyframes nav-live-pulse {
    50% {
      opacity: 0.3;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-live::before {
      animation: none;
    }
  }

  /* Shrink the nav before it can crowd the brand, buying room down to the stack point. */
  @media (max-width: 760px) {
    nav a {
      font-size: 0.8rem;
      letter-spacing: 0.06em;
    }
  }

  @media (max-width: 640px) {
    .site-header {
      grid-template-columns: 1fr;
      justify-items: start;
      gap: var(--space-sm);
      padding: var(--space-sm) var(--space-md);
    }

    nav {
      justify-content: flex-start;
      gap: var(--space-sm);
    }

    /* Stacked mode: the music widget is its own full-width row (last). Stretching
       it to the row width lets the dropdown span the header edge-to-edge via
       left/right:0 (set in NowPlaying's mobile query) without overlapping the nav
       above it. */
    .hdr-music {
      justify-self: stretch;
      width: 100%;
    }
  }
</style>
