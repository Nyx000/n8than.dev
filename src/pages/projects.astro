---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';

const liveCount = projects.filter((p) => p.status === 'live').length;
const groups = [
  { heading: 'Client and production work', items: projects.filter((p) => p.kind === 'work') },
  { heading: 'Tools and open source', items: projects.filter((p) => p.kind === 'tools') },
];
---

<BaseLayout
  title="Projects | n8than.dev"
  description="Client work, production apps, and AI tooling. The live ones are a click away."
>
  <div class="container">
    <h1 class="k-heading">Projects</h1>
    <p class="intro">{projects.length} projects, {liveCount} running live.</p>

    {
      groups.map((group) => (
        <section>
          <h2 class="k-subheading">{group.heading}</h2>
          <div class="records">
            {group.items.map((project) => (
              <ProjectCard {...project} />
            ))}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  section {
    margin-top: var(--space-xl);
  }

  section:first-of-type {
    margin-top: var(--space-lg);
  }

  .k-subheading {
    margin-bottom: var(--space-md);
  }

  .records {
    display: grid;
    gap: 1.25rem;
  }
</style>
