---
import BaseLayout from '../layouts/BaseLayout.astro';
import Chatter from '../components/Chatter.astro';

// Bitrate history: one bar per stats tick (5 s), newest on the right, so the strip covers the
// last three minutes of what the desk is sending. Heights are set by the script.
const BARS = 36;
---

<BaseLayout title="Live | n8than.dev" description="Live game stream, when there is one.">
  <section class="container stagger" id="live-root">
    <h1 class="section-heading">Live</h1>

    <div class="live-bar" id="live-bar" data-state="offline">
      <span class="live-chip" id="live-chip" data-state="offline">Offline</span>
      <span class="live-viewers" id="live-viewers" hidden></span>
      <span class="live-meter" aria-hidden="true">
        {Array.from({ length: BARS }, (_, i) => <span style={`--i:${i}`} />)}
      </span>
      <span class="live-readout" aria-hidden="true">
        <span id="live-format">CH-01</span>
        <span>RELAY HIL-1</span>
        <span id="live-signal">NO SIGNAL</span>
      </span>
    </div>

    <div class="live-frame">
      <video id="live-video" muted autoplay playsinline controls aria-label="live game stream"
      ></video>
      <div class="live-overlay" id="live-offline">
        <p class="live-offline-title">Not live right now</p>
        <p class="live-offline-sub">This page checks every 30 seconds and starts on its own.</p>
      </div>
      <div class="live-doors" aria-hidden="true">
        <span class="door door-l"></span>
        <span class="door door-r"></span>
        <p class="doors-msg">Incoming signal</p>
      </div>
      <button type="button" class="live-unmute" id="live-unmute" hidden>Unmute</button>
    </div>

    <p class="live-hud" id="live-hud" hidden>
      <span class="hud-tick" id="hud-tick" aria-hidden="true"></span>
      <span class="hud-item" id="hud-fps-i" title="frame rate reaching you"
        ><b id="hud-fps">–</b> fps</span
      >
      <span class="hud-item" id="hud-delay-i" title="delay to you: network plus playback buffer"
        ><b id="hud-delay">–</b><span id="hud-delay-u"></span></span
      >
      <span class="hud-item" title="upload from the desk"><b id="hud-in">–</b> Mb/s in</span>
      <span class="hud-item" title="server bandwidth out, all viewers"
        ><b id="hud-out">–</b> out</span
      >
      <span class="hud-item" id="hud-src-i" title="source"><b id="hud-res">–</b></span>
      <span class="hud-item" id="hud-loss-i" title="packets lost on the way to you"
        ><b id="hud-loss">–</b>% loss</span
      >
      <span class="hud-item" id="hud-up-i" title="on air"><b id="hud-uptime">–</b></span>
      <span class="hud-item" title="served this stream"><b id="hud-total">–</b> GB</span>
    </p>

    <Chatter
      class="live-chat"
      title="STREAM CHAT"
      channel="#live"
      endpoint="/api/live/chat"
      pollMs={3_000}
      placeholder="say something…"
      hidden
    />
  </section>
</BaseLayout>

<style>
  .live-bar {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-sm);
    font-family: var(--font-display);
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .live-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    color: var(--color-muted);
  }

  .live-chip::before {
    content: '';
    width: 0.55em;
    height: 0.55em;
    border-radius: 50%;
    background: var(--color-border);
  }

  .live-chip[data-state='live'] {
    color: var(--color-accent);
  }

  .live-chip[data-state='live']::before {
    background: var(--color-accent);
    animation: live-pulse 1.6s var(--ease) infinite;
  }

  .live-chip[data-state='connecting'] {
    color: var(--color-warn);
  }

  .live-chip[data-state='connecting']::before {
    background: var(--color-warn);
  }

  @keyframes live-pulse {
    50% {
      opacity: 0.35;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .live-chip[data-state='live']::before {
      animation: none;
    }
  }

  .live-viewers {
    color: var(--color-muted);
  }

  /* Bitrate history: each bar is one stats tick of the upload from the desk, scaled to the
     tallest bar in view (the script sets the height inline and marks bars that hold a sample).
     Flat and dim while offline; amber while connecting. */
  .live-meter {
    flex: 1;
    min-width: 6rem;
    height: 1.1rem;
    display: flex;
    align-items: flex-end;
    gap: 2px;
    opacity: 0.85;
  }

  .live-meter > span {
    flex: 1;
    height: 100%;
    background: var(--color-border);
    transform-origin: bottom;
    transform: scaleY(0.12);
    transition:
      background var(--dur-med) var(--ease),
      transform var(--dur-slow) var(--ease-out);
  }

  .live-bar[data-state='live'] .live-meter > span[data-on] {
    background: var(--color-accent);
  }

  /* The newest sample, a little brighter so the eye finds where the history ends. */
  .live-bar[data-state='live'] .live-meter > span[data-on]:last-child {
    background: var(--color-accent-hover);
  }

  .live-bar[data-state='connecting'] .live-meter > span {
    background: var(--color-warn);
    transform: scaleY(0.3);
  }

  @media (prefers-reduced-motion: reduce) {
    .live-meter > span {
      transition: none;
    }
  }

  .live-readout {
    display: flex;
    gap: 0.9em;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--color-muted);
    white-space: nowrap;
  }

  .live-readout > span + span::before {
    content: '//';
    margin-right: 0.9em;
    color: var(--color-border);
  }

  .live-bar[data-state='live'] #live-signal {
    color: var(--color-accent);
  }

  /* Phone width: chip + count on the first row, the meter and readout each take a full row. */
  @media (max-width: 640px) {
    .live-bar {
      flex-wrap: wrap;
      row-gap: var(--space-sm);
    }

    .live-meter {
      order: 3;
      flex-basis: 100%;
    }

    .live-readout {
      order: 4;
    }
  }

  .live-chat {
    margin-top: var(--space-lg);
  }

  .live-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  #live-video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #000;
  }

  .live-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    padding: var(--space-md);
    text-align: center;
    background: var(--color-surface);
  }

  .live-overlay[hidden] {
    display: none;
  }

  .live-offline-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--color-text);
  }

  .live-offline-sub {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.92rem;
  }

  .live-unmute {
    position: absolute;
    top: var(--space-md);
    right: var(--space-md);
    padding: var(--space-sm) var(--space-md);
    font-family: var(--font-display);
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-bg);
    background: var(--color-accent);
    border: 0;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease);
  }

  .live-unmute:hover {
    background: var(--color-accent-hover);
  }

  .live-unmute[hidden] {
    display: none;
  }

  /* ----- HUD: the stream's vitals as one quiet readout line under the player, in the
     same voice as the CH-01 // RELAY strip above. Values a step brighter than their units;
     a reading outside its healthy range turns amber. ----- */
  .live-hud {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35em 0.9em;
    margin: var(--space-sm) 0 0;
    padding-top: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--color-muted);
  }

  .live-hud[hidden] {
    display: none;
  }

  .hud-item {
    white-space: nowrap;
    cursor: default;
  }

  .hud-item + .hud-item::before {
    content: '//';
    margin-right: 0.9em;
    color: var(--color-border);
  }

  /* Phone width wraps the line; a separator would then start the second row. */
  @media (max-width: 640px) {
    .live-hud {
      column-gap: 1.2em;
    }

    .hud-item + .hud-item::before {
      content: none;
    }
  }

  .hud-item b {
    font-weight: 400;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
  }

  .hud-item[data-warn] b {
    color: var(--color-warn);
  }

  /* The slow tick: a hairline along the top that fills between readings. */
  .hud-tick {
    position: absolute;
    top: 0;
    left: 0;
    height: 1px;
    width: 100%;
    background: var(--color-accent);
    opacity: 0.35;
    transform-origin: left;
    transform: scaleX(0);
  }

  .hud-tick.is-running {
    animation: hud-tick var(--tick-ms, 5000ms) linear forwards;
  }

  @keyframes hud-tick {
    to {
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hud-tick.is-running {
      animation: none;
    }
  }
</style>

<style>
  /* ===== Go-live intro =====
     Plays once for viewers who were waiting on the offline screen when the stream starts.
     #live-root[data-intro] drives it: 'arming' while WebRTC connects (blast doors shut over
     the frame, a wave runs the meter, "Incoming signal" blinks on the seam), then 'open' once
     real frames are playing (doors part, the frame flares, the readout and chat rise in).
     Colours are the site palette only: accent, accent-hover, warn, surface. */
  .live-doors {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: none;
    pointer-events: none;
  }

  #live-root[data-intro='arming'] .live-doors,
  #live-root[data-intro='open'] .live-doors {
    display: block;
  }

  /* After the intro: switch the children's animations off rather than removing the state.
     Dropping back to the site-wide .stagger entrance would replay its fade-up. */
  #live-root[data-intro='done'] > * {
    animation: none;
  }

  .door {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50%;
    background:
      repeating-linear-gradient(-45deg, transparent 0 18px, rgba(255, 102, 0, 0.035) 18px 36px),
      var(--color-surface);
  }

  .door-l {
    left: 0;
    box-shadow:
      inset -2px 0 0 var(--color-accent),
      8px 0 28px rgba(255, 102, 0, 0.45);
  }

  .door-r {
    right: 0;
    box-shadow:
      inset 2px 0 0 var(--color-accent),
      -8px 0 28px rgba(255, 102, 0, 0.45);
  }

  .doors-msg {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;
    margin: 0;
    padding: 0.35em 0.9em;
    transform: translate(-50%, -50%);
    font-family: var(--font-display);
    font-size: clamp(0.85rem, 0.7rem + 0.8vw, 1.15rem);
    letter-spacing: 0.14em;
    white-space: nowrap;
    color: var(--color-accent);
    background: var(--color-bg);
    border: 1px solid var(--color-accent);
    text-shadow: 0 0 10px rgba(255, 102, 0, 0.6);
    box-shadow: 0 0 22px rgba(255, 102, 0, 0.3);
  }

  #live-root[data-intro='arming'] .doors-msg {
    animation: doors-blink 0.8s steps(2, jump-none) infinite;
  }

  @keyframes doors-blink {
    from {
      opacity: 1;
    }
    to {
      opacity: 0.25;
    }
  }

  #live-root[data-intro='open'] .door-l {
    animation: door-open-l 1.5s 0.3s cubic-bezier(0.65, 0, 0.25, 1) forwards;
  }

  #live-root[data-intro='open'] .door-r {
    animation: door-open-r 1.5s 0.3s cubic-bezier(0.65, 0, 0.25, 1) forwards;
  }

  #live-root[data-intro='open'] .doors-msg {
    animation: doors-msg-out 0.5s ease-in forwards;
  }

  @keyframes door-open-l {
    to {
      transform: translateX(-101%);
    }
  }

  @keyframes door-open-r {
    to {
      transform: translateX(101%);
    }
  }

  @keyframes doors-msg-out {
    to {
      opacity: 0;
      transform: translate(-50%, -50%) scale(1.25);
    }
  }

  /* The frame flares once as the doors clear. */
  #live-root[data-intro='open'] .live-frame {
    animation: frame-flare 2.2s 1s ease-out both;
  }

  @keyframes frame-flare {
    0% {
      border-color: var(--color-border);
      box-shadow: 0 0 0 0 rgba(255, 102, 0, 0);
    }
    25% {
      border-color: var(--color-accent-hover);
      box-shadow:
        0 0 0 1px var(--color-accent),
        0 0 48px rgba(255, 102, 0, 0.45);
    }
    100% {
      border-color: var(--color-border);
      box-shadow: 0 0 0 0 rgba(255, 102, 0, 0);
    }
  }

  /* Meter: a wave of light runs left to right while the signal arms. */
  #live-root[data-intro='arming'] .live-meter > span {
    background: var(--color-accent);
    animation: bar-wave 1.4s calc(var(--i) * 35ms) ease-in-out infinite;
  }

  @keyframes bar-wave {
    0%,
    100% {
      transform: scaleY(0.12);
      background: var(--color-warn);
    }
    35% {
      transform: scaleY(1);
      background: var(--color-accent-hover);
    }
  }

  #live-root[data-intro='arming'] .live-chip,
  #live-root[data-intro='open'] .live-chip {
    animation: chip-flash 0.5s steps(2, jump-none) 5;
  }

  @keyframes chip-flash {
    from {
      opacity: 1;
    }
    to {
      opacity: 0.2;
    }
  }

  /* Readout and chat stay out of sight while armed, then rise in after the flare. */
  /* animation: none too: the finished .stagger fade-up still holds opacity 1 through its fill,
     and animation values beat ordinary declarations. */
  #live-root[data-intro='arming'] .live-hud,
  #live-root[data-intro='arming'] .live-chat {
    animation: none;
    opacity: 0;
  }

  #live-root[data-intro='open'] .live-hud {
    animation: intro-rise 0.9s 1.6s var(--ease-out) both;
  }

  #live-root[data-intro='open'] .live-chat {
    animation: intro-rise 1s 2s var(--ease-out) both;
  }

  @keyframes intro-rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #live-root[data-intro] .live-doors {
      display: none;
    }

    #live-root[data-intro] *,
    #live-root[data-intro] .live-frame {
      animation: none !important;
    }

    #live-root[data-intro='arming'] .live-hud,
    #live-root[data-intro='arming'] .live-chat {
      opacity: 1;
    }
  }
</style>

<style is:global>
  /* No CRT scanlines on /live: the site-wide overlay (body::after, global.css) would sit over
     the stream. Lifting the player above it instead would also lift it over the header's
     music dropdown, so the overlay is switched off for this page only. */
  body:has(#live-root)::after {
    content: none;
  }
</style>

<script>
  // Playback prefers WebRTC (WHEP, sub-second) and falls back to LL-HLS (a few seconds
  // behind) when WebRTC can't connect, typically a network that blocks UDP. Both are
  // routed through Caddy to the MediaMTX relay; see deploy/Caddyfile, /api/live/*.
  import type Hls from 'hls.js';

  const STATUS_URL = '/api/live/status';
  const WHEP_URL = '/api/live/rtc/game/whep';
  const HLS_URL = '/api/live/hls/game/index.m3u8';
  // Status check cadence while offline: how soon an open page notices the stream starting.
  // While live the page ticks faster to keep the HUD current. Playback latency is WebRTC and
  // depends on neither.
  const POLL_MS = 30_000;
  const STATS_MS = 5_000;
  const ICE_TIMEOUT_MS = 8_000;

  interface PathStatus {
    online: boolean;
    onlineTime: string | null;
    readers: unknown[];
    inboundBytes: number;
    outboundBytes: number;
    tracks2?: {
      codec: string;
      codecProps?: { width?: number; height?: number; profile?: string } | null;
    }[];
  }

  type Player =
    | { kind: 'idle' }
    | { kind: 'connecting' }
    | { kind: 'webrtc'; pc: RTCPeerConnection; session: string | null }
    | { kind: 'hls'; hls: Hls | null };

  let player: Player = { kind: 'idle' };
  // True once this page view has shown the offline screen, so a start that follows it gets the
  // go-live intro. Someone who opens the page mid-stream just sees the stream.
  let sawOffline = false;
  let introTimer: number | undefined;
  const INTRO_MIN_ARMED_MS = 2_000;
  let pollTimer: number | undefined;
  // Set when WebRTC failed on this page view, so the next attempt goes straight to HLS.
  let webrtcFailed = false;

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;

  function render(online: boolean, viewers: number | null) {
    const chip = $('live-chip');
    const count = $('live-viewers');
    const overlay = $('live-offline');
    if (!chip || !count || !overlay) return;
    const state = !online ? 'offline' : player.kind === 'connecting' ? 'connecting' : 'live';
    if (!online) sawOffline = true;
    chip.dataset.state = state;
    chip.textContent =
      state === 'offline' ? 'Offline' : state === 'connecting' ? 'Connecting' : 'Live';
    // Chat only while the stream is up.
    const chat = document.querySelector<HTMLElement>('[data-chatter]');
    if (chat) chat.hidden = !online;
    const hud = $('live-hud');
    if (hud) hud.hidden = !online;
    const bar = $('live-bar');
    const signal = $('live-signal');
    if (bar) bar.dataset.state = state;
    if (signal)
      signal.textContent =
        state === 'offline' ? 'NO SIGNAL' : state === 'connecting' ? 'ACQUIRING' : 'SIGNAL LOCKED';
    count.hidden = !online || viewers == null;
    if (viewers != null) count.textContent = `${viewers} watching`;
    overlay.hidden = online && player.kind !== 'idle';
  }

  async function fetchStatus(): Promise<PathStatus | null> {
    try {
      const res = await fetch(STATUS_URL, { cache: 'no-store' });
      if (!res.ok) return null; // 404 before the first publish: path not created yet
      return (await res.json()) as PathStatus;
    } catch {
      return null;
    }
  }

  async function tick() {
    const status = await fetchStatus();
    const online = status?.online === true;
    if (online && player.kind === 'idle') void start();
    if (!online && player.kind !== 'idle') stopPlayer();
    render(online, status ? status.readers.length : null);
    if (online && status) await updateHud(status);
    else resetHud();
  }

  async function start() {
    player = { kind: 'connecting' };
    const video = $<HTMLVideoElement>('live-video');
    if (sawOffline && video) armIntro(video);
    render(true, null);
    schedule(); // switch to the live cadence
    if (!video) return;
    try {
      player = webrtcFailed ? await startHls(video) : await startWebRtc(video);
    } catch {
      if (!webrtcFailed) {
        webrtcFailed = true;
        try {
          player = await startHls(video);
        } catch {
          player = { kind: 'idle' }; // next tick retries
        }
      } else {
        player = { kind: 'idle' };
      }
    }
    if (player.kind === 'idle') endIntro('done');
    showUnmute(video);
    void tick();
  }

  // ----- go-live intro (styles: "Go-live intro" above) -----
  function armIntro(video: HTMLVideoElement) {
    const root = $('live-root');
    if (!root || root.dataset.intro === 'arming' || root.dataset.intro === 'open') return;
    root.dataset.intro = 'arming';
    const armedAt = performance.now();
    // Open on the first real frame (or after 8 s if frames are slow), but never before the
    // "Incoming signal" beat has had 2 s on screen; the whole sequence then runs about 3.5 s.
    const open = () => {
      video.removeEventListener('playing', open);
      if (introTimer != null) clearTimeout(introTimer);
      if (root.dataset.intro !== 'arming') return;
      const wait = Math.max(0, INTRO_MIN_ARMED_MS - (performance.now() - armedAt));
      introTimer = window.setTimeout(() => {
        root.dataset.intro = 'open';
        introTimer = window.setTimeout(() => endIntro('done'), 3_600);
      }, wait);
    };
    video.addEventListener('playing', open);
    introTimer = window.setTimeout(open, 8_000);
  }

  // 'done' after a played intro (see the CSS note); 'reset' clears it for a fresh page.
  function endIntro(how: 'done' | 'reset') {
    if (introTimer != null) clearTimeout(introTimer);
    introTimer = undefined;
    const root = $('live-root');
    if (!root || !root.dataset.intro) return;
    if (how === 'done') root.dataset.intro = 'done';
    else delete root.dataset.intro;
  }

  async function startWebRtc(video: HTMLVideoElement): Promise<Player> {
    const pc = new RTCPeerConnection();
    const stream = new MediaStream();
    pc.addTransceiver('video', { direction: 'recvonly' });
    pc.addTransceiver('audio', { direction: 'recvonly' });
    pc.ontrack = (ev) => {
      stream.addTrack(ev.track);
      video.srcObject = stream;
      video.play().catch(() => {});
    };

    try {
      await pc.setLocalDescription(await pc.createOffer());
      await iceGathered(pc);
      const res = await fetch(WHEP_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/sdp' },
        body: pc.localDescription!.sdp,
      });
      if (res.status !== 201) throw new Error(`WHEP ${res.status}`);
      const session = res.headers.get('Location');
      await pc.setRemoteDescription({ type: 'answer', sdp: await res.text() });
      await connected(pc);

      const p: Player = { kind: 'webrtc', pc, session };
      // A publisher that stops ends the session; drop back to idle and let polling decide.
      pc.onconnectionstatechange = () => {
        if (pc.connectionState === 'failed' || pc.connectionState === 'closed') {
          if (player === p) stopPlayer();
        }
      };
      return p;
    } catch (err) {
      pc.close();
      throw err;
    }
  }

  // Non-trickle WHEP: send one offer carrying every local candidate.
  function iceGathered(pc: RTCPeerConnection): Promise<void> {
    if (pc.iceGatheringState === 'complete') return Promise.resolve();
    return new Promise((resolve) => {
      const done = () => {
        pc.removeEventListener('icegatheringstatechange', check);
        resolve();
      };
      const check = () => pc.iceGatheringState === 'complete' && done();
      pc.addEventListener('icegatheringstatechange', check);
      setTimeout(done, 2_000); // host candidates are enough; the server has a public IP
    });
  }

  function connected(pc: RTCPeerConnection): Promise<void> {
    return new Promise((resolve, reject) => {
      const timer = setTimeout(() => reject(new Error('ICE timeout')), ICE_TIMEOUT_MS);
      const check = () => {
        if (pc.connectionState === 'connected') {
          clearTimeout(timer);
          resolve();
        } else if (pc.connectionState === 'failed') {
          clearTimeout(timer);
          reject(new Error('ICE failed'));
        }
      };
      pc.addEventListener('connectionstatechange', check);
      check();
    });
  }

  async function startHls(video: HTMLVideoElement): Promise<Player> {
    // A failed WebRTC attempt may have set srcObject, which would outrank src/MSE.
    video.srcObject = null;
    const { default: HlsCtor } = await import('hls.js');
    if (HlsCtor.isSupported()) {
      const hls = new HlsCtor({ lowLatencyMode: true, backBufferLength: 0 });
      const p: Player = { kind: 'hls', hls };
      hls.on(HlsCtor.Events.ERROR, (_evt, data) => {
        if (data.fatal && player === p) stopPlayer();
      });
      hls.loadSource(HLS_URL);
      hls.attachMedia(video);
      video.play().catch(() => {});
      return p;
    }
    if (video.canPlayType('application/vnd.apple.mpegurl')) {
      video.src = HLS_URL; // Safari / iOS: native HLS
      video.play().catch(() => {});
      return { kind: 'hls', hls: null };
    }
    throw new Error('no HLS support');
  }

  // ===== HUD =====
  // Server side (MediaMTX path API): byte counters give the upload from the desk and the
  // relay's egress as rates between ticks. Viewer side: this browser's own WebRTC stats (or
  // the video element under HLS) give frame rate, delay and loss.
  const BAR_COUNT = 36;
  let history: number[] = []; // upload Mb/s per tick, oldest first
  let prevServer: { t: number; inB: number; outB: number; since: string | null } | null = null;
  let prevFrames: { t: number; frames: number } | null = null;

  function setText(id: string, text: string) {
    const el = $(id);
    if (el && el.textContent !== text) el.textContent = text;
  }

  function setTitle(id: string, text: string) {
    const el = $(id);
    if (el) el.title = text;
  }

  function warn(id: string, on: boolean) {
    const cell = $(id)?.closest<HTMLElement>('.hud-item');
    if (cell) cell.toggleAttribute('data-warn', on);
  }

  function clock(sec: number): string {
    const s = Math.max(0, Math.floor(sec));
    const h = Math.floor(s / 3600);
    const m = Math.floor((s % 3600) / 60);
    const pad = (n: number) => String(n).padStart(2, '0');
    return h ? `${h}:${pad(m)}:${pad(s % 60)}` : `${m}:${pad(s % 60)}`;
  }

  function drawMeter() {
    const bars = document.querySelectorAll<HTMLElement>('.live-meter > span');
    const peak = Math.max(1, ...history);
    const offset = bars.length - history.length;
    bars.forEach((bar, i) => {
      const v = history[i - offset];
      if (v == null) {
        bar.style.transform = '';
        bar.removeAttribute('data-on');
      } else {
        bar.style.transform = `scaleY(${Math.max(0.12, v / peak).toFixed(3)})`;
        bar.setAttribute('data-on', '');
      }
    });
  }

  function restartTick() {
    const t = $('hud-tick');
    if (!t) return;
    t.style.setProperty('--tick-ms', `${STATS_MS}ms`);
    t.classList.remove('is-running');
    void t.offsetWidth; // restart the animation
    t.classList.add('is-running');
  }

  interface ViewerStats {
    fps: number | null;
    delayS: number | null;
    delayNote: string;
    lossPct: number | null;
    dropped: number | null;
  }

  async function viewerStats(): Promise<ViewerStats> {
    const video = $<HTMLVideoElement>('live-video');
    const out: ViewerStats = {
      fps: null,
      delayS: null,
      delayNote: '',
      lossPct: null,
      dropped: null,
    };
    if (player.kind === 'webrtc') {
      const report = await player.pc.getStats();
      let rtt: number | null = null;
      report.forEach((r) => {
        if (r.type === 'inbound-rtp' && r.kind === 'video') {
          // 0 right after (re)connecting means no measurement yet, not a stalled stream.
          if (typeof r.framesPerSecond === 'number' && r.framesPerSecond > 0) {
            out.fps = r.framesPerSecond;
          }
          const lost = r.packetsLost ?? 0;
          const got = r.packetsReceived ?? 0;
          if (lost + got > 0) out.lossPct = (100 * lost) / (lost + got);
          if (typeof r.framesDropped === 'number') out.dropped = r.framesDropped;
          if (r.jitterBufferEmittedCount > 0) {
            out.delayS = r.jitterBufferDelay / r.jitterBufferEmittedCount;
          }
        }
        if (r.type === 'candidate-pair' && r.nominated && r.state === 'succeeded') {
          if (typeof r.currentRoundTripTime === 'number') rtt = r.currentRoundTripTime;
        }
      });
      // One-way network time (half the round trip) plus the time frames wait in this
      // browser's jitter buffer. Excludes encode and decode, a few ms each at these settings.
      if (out.delayS != null && rtt != null) out.delayS += rtt / 2;
      out.delayNote = rtt != null ? `rtt ${Math.round(rtt * 1000)} ms` : 'webrtc';
    } else if (player.kind === 'hls') {
      if (player.hls && Number.isFinite(player.hls.latency)) out.delayS = player.hls.latency;
      out.delayNote = 'hls fallback';
    }
    // Frame rate from what actually got painted, when WebRTC stats don't say (HLS).
    if (out.fps == null && video?.getVideoPlaybackQuality) {
      const q = video.getVideoPlaybackQuality();
      const now = performance.now();
      if (prevFrames) {
        const dt = (now - prevFrames.t) / 1000;
        if (dt > 0) out.fps = (q.totalVideoFrames - prevFrames.frames) / dt;
      }
      prevFrames = { t: now, frames: q.totalVideoFrames };
      out.dropped ??= q.droppedVideoFrames;
    }
    return out;
  }

  async function updateHud(st: PathStatus) {
    const now = performance.now();
    // Rates need two samples from the same broadcast; a new onlineTime or a counter that went
    // backwards means the relay restarted the path, so start over.
    if (prevServer && (prevServer.since !== st.onlineTime || st.inboundBytes < prevServer.inB)) {
      prevServer = null;
      history = [];
    }
    if (prevServer) {
      const dt = (now - prevServer.t) / 1000;
      if (dt > 0.5) {
        const inMbps = ((st.inboundBytes - prevServer.inB) * 8) / dt / 1e6;
        const outMbps = ((st.outboundBytes - prevServer.outB) * 8) / dt / 1e6;
        setText('hud-in', inMbps.toFixed(1));
        setText('hud-out', outMbps.toFixed(1));
        history.push(inMbps);
        if (history.length > BAR_COUNT) history.shift();
        drawMeter();
      }
    }
    prevServer = { t: now, inB: st.inboundBytes, outB: st.outboundBytes, since: st.onlineTime };

    setText('hud-total', (st.outboundBytes / 1e9).toFixed(2));

    const video = (st.tracks2 ?? []).find((t) =>
      ['H264', 'H265', 'AV1', 'VP9', 'VP8'].includes(t.codec),
    );
    const w = video?.codecProps?.width;
    const h = video?.codecProps?.height;
    setText('hud-res', h ? `${h}p` : '–');
    const profile = video?.codecProps?.profile;
    const codecName = video?.codec === 'H264' ? 'h.264' : (video?.codec ?? '').toLowerCase();
    setTitle(
      'hud-src-i',
      [w && h ? `${w}×${h}` : '', codecName, profile?.toLowerCase()].filter(Boolean).join(' '),
    );

    if (st.onlineTime) {
      const since = new Date(st.onlineTime);
      setText('hud-uptime', clock((Date.now() - since.getTime()) / 1000));
      setTitle(
        'hud-up-i',
        `on air since ${since.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`,
      );
    }

    const v = await viewerStats();
    setText('hud-fps', v.fps != null ? Math.round(v.fps).toString() : '–');
    setTitle(
      'hud-fps-i',
      `frame rate reaching you${v.dropped != null ? `, ${v.dropped} dropped here` : ''}`,
    );
    warn('hud-fps', v.fps != null && v.fps < 55);
    if (v.delayS != null) {
      const ms = v.delayS * 1000;
      setText('hud-delay', ms < 1000 ? String(Math.round(ms)) : v.delayS.toFixed(1));
      setText('hud-delay-u', ms < 1000 ? ' ms' : ' s');
    } else {
      setText('hud-delay', '–');
      setText('hud-delay-u', '');
    }
    setTitle('hud-delay-i', `delay to you: network plus playback buffer (${v.delayNote})`);
    warn('hud-delay', v.delayS != null && v.delayS > 1);
    setText('hud-loss', v.lossPct != null ? v.lossPct.toFixed(2) : '–');
    warn('hud-loss', v.lossPct != null && v.lossPct > 1);

    // Readout: the format as it actually arrives, e.g. 1080p90.
    if (h && v.fps != null && v.fps > 0) setText('live-format', `${h}p${Math.round(v.fps)}`);

    restartTick();
  }

  function resetHud() {
    prevServer = null;
    prevFrames = null;
    history = [];
    drawMeter();
    setText('live-format', 'CH-01');
    $('hud-tick')?.classList.remove('is-running');
  }

  function stopPlayer() {
    const video = $<HTMLVideoElement>('live-video');
    if (player.kind === 'webrtc') {
      const { pc, session } = player;
      pc.onconnectionstatechange = null;
      pc.close();
      // Free the reader slot now rather than when MediaMTX notices the dead peer.
      if (session) fetch(session, { method: 'DELETE', keepalive: true }).catch(() => {});
    } else if (player.kind === 'hls') {
      player.hls?.destroy();
    }
    player = { kind: 'idle' };
    if (video) {
      video.srcObject = null;
      if (video.getAttribute('src')) {
        video.removeAttribute('src');
        video.load();
      }
    }
    const unmute = $('live-unmute');
    if (unmute) unmute.hidden = true;
  }

  // Autoplay only works muted; one tap brings the game audio in.
  function showUnmute(video: HTMLVideoElement) {
    const btn = $('live-unmute');
    if (!btn) return;
    btn.hidden = player.kind === 'idle' || !video.muted;
    btn.onclick = () => {
      video.muted = false;
      video.play().catch(() => {});
      btn.hidden = true;
    };
    video.onvolumechange = () => {
      if (!video.muted) btn.hidden = true;
    };
  }

  // Self-scheduling loop: the next check is 5 s away while something plays, 30 s while idle.
  function schedule() {
    if (pollTimer != null) clearTimeout(pollTimer);
    const ms = player.kind === 'idle' ? POLL_MS : STATS_MS;
    pollTimer = window.setTimeout(async () => {
      await tick();
      if (pollTimer != null) schedule();
    }, ms);
  }

  function startPolling() {
    stopPolling();
    void tick();
    schedule();
  }

  function stopPolling() {
    if (pollTimer != null) clearTimeout(pollTimer);
    pollTimer = undefined;
  }

  // ClientRouter is active: init on every page load, stop everything when leaving /live.
  document.addEventListener('astro:page-load', () => {
    if ($('live-root')) {
      webrtcFailed = false;
      sawOffline = false;
      endIntro('reset');
      startPolling();
    } else {
      stopPolling();
      stopPlayer();
    }
  });

  // A hidden tab keeps playing (people listen in the background) but stops polling
  // only when nothing is playing.
  document.addEventListener('visibilitychange', () => {
    if (!$('live-root')) return;
    if (document.hidden && player.kind === 'idle') stopPolling();
    else if (!document.hidden && pollTimer == null) startPolling();
  });

  window.addEventListener('pagehide', () => stopPlayer());
</script>
