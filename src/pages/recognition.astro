---
import BaseLayout from '../layouts/BaseLayout.astro';
import { testimonials } from '../data/testimonials';

// Derived so the summary can't drift from the data: unique colleagues and the
// calendar-year span the notes cover.
const colleagues = new Set(testimonials.map((t) => t.name)).size;
const years = testimonials.map((t) => Number(t.iso.slice(0, 4)));
const spanStart = Math.min(...years);
const spanEnd = Math.max(...years);

const featured = testimonials.filter((t) => t.featured);
const rest = testimonials.filter((t) => !t.featured);
---

<BaseLayout
  title="Recognition | n8than.dev"
  description="Eighteen night-shift thank-you notes and one award, collected 2022–2025 at Scripps Mercy Hospital — the problem domain the software came from."
>
  <div class="container">
    <h1 class="k-heading">Recognition</h1>
    <p class="intro">
      Eighteen thank-you notes and one award, collected 2022–2025 on the night shift at Scripps
      Mercy Hospital — kept here as evidence, not nostalgia. This is the problem domain the software
      came from.
    </p>

    <div class="k-panel award">
      <img
        src="/values-in-action-award.jpg"
        alt="2025 Values in Action Honoree certificate for Nathan Huse, Scripps Mercy Hospital San Diego"
        width="974"
        height="757"
        loading="eager"
      />
      <div>
        <h2 class="k-subheading">Values in Action Honoree</h2>
        <p>Scripps Mercy Hospital San Diego</p>
        <p class="award-year">2025</p>
      </div>
    </div>

    <section>
      <h2 class="k-subheading">Colleague testimonials</h2>
      <dl class="k-readouts">
        <div class="k-readout">
          <dt>Notes</dt>
          <dd>{testimonials.length}</dd>
        </div>
        <div class="k-readout">
          <dt>Colleagues</dt>
          <dd>{colleagues}</dd>
        </div>
        <div class="k-readout">
          <dt>Years</dt>
          <dd>{spanStart}–{spanEnd}</dd>
        </div>
      </dl>

      <div class="featured">
        {
          featured.map((t) => (
            <blockquote class="k-quote">
              <p>{t.message}</p>
              <footer>
                {t.name}, <time datetime={t.iso}>{t.date}</time>
              </footer>
            </blockquote>
          ))
        }
      </div>

      <div class="notes">
        {
          rest.map((t) => (
            <blockquote class="k-quote k-quote--quiet">
              <p>{t.message}</p>
              <footer>
                {t.name}, <time datetime={t.iso}>{t.date}</time>
              </footer>
            </blockquote>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* Layout only: the parts come from src/kit/. */
  .award {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md) var(--space-lg);
    margin-bottom: var(--space-xl);
  }

  .award img {
    display: block;
    width: 100%;
    max-width: 22rem;
    height: auto;
    border-radius: var(--radius-sm);
  }

  .award p {
    margin: 0;
  }

  .award-year {
    font-family: var(--font-display);
    color: var(--color-muted);
  }

  .k-readouts {
    margin: var(--space-md) 0 var(--space-lg);
  }

  .featured {
    display: grid;
    gap: var(--space-lg);
    margin-bottom: var(--space-xl);
  }

  /* The rest read as one run of notes: a hairline between them, no box each. */
  .notes {
    columns: 2;
    column-gap: var(--space-xl);
  }

  .notes .k-quote {
    break-inside: avoid;
    max-width: none;
    padding-block: var(--space-md);
    border-top: 1px solid var(--color-border);
  }

  @media (max-width: 800px) {
    .notes {
      columns: 1;
    }
  }
</style>
