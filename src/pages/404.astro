---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 — not found | n8than.dev"
  description="That page doesn't exist. Older pages were retired; the projects page has what's current."
>
  <section class="container notfound">
    <h1 class="code">404</h1>
    <div class="k-term" role="group" aria-label="terminal output">
      <p class="line">
        <span class="k-term__prompt" aria-hidden="true">$</span> cat <span class="path" data-path
          >/requested/page</span
        >
      </p>
      <p class="line k-term__err">
        cat: <span class="path" data-path>/requested/page</span>: No such file or directory
      </p>
      <p class="line hint">older pages were retired. /projects has what's current.</p>
    </div>
    <nav class="recover" aria-label="Where to go next">
      <a class="k-btn k-btn--primary" href="/">Home</a>
      <a class="k-btn" href="/projects">Projects</a>
    </nav>
  </section>

  <script>
    // Progressive enhancement: show the path the visitor actually asked for.
    // This is a processed (bundled) script → served from /_astro as an external
    // module, so it passes the tightened `script-src 'self'` CSP. With JS off,
    // the static `/requested/page` copy stands.
    document.addEventListener('astro:page-load', () => {
      const path = location.pathname;
      if (!path || path === '/404.html' || path === '/404' || path === '/404/') return;
      const shown = path.length > 64 ? path.slice(0, 63) + '…' : path;
      document.querySelectorAll('[data-path]').forEach((el) => {
        el.textContent = shown;
      });
    });
  </script>
</BaseLayout>

<style>
  .container {
    width: 100%;
    max-width: 42rem;
    margin: 0 auto;
    padding: var(--space-xl) var(--space-md);
  }

  .notfound {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .code {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 12vw, 6rem);
    font-weight: 400;
    line-height: 1;
    color: var(--color-accent);
    margin-bottom: var(--space-lg);
  }

  .k-term {
    margin-bottom: var(--space-lg);
  }

  .line {
    margin: 0;
  }

  .hint {
    color: var(--color-muted);
    margin-top: var(--space-sm);
  }

  .recover {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
</style>
